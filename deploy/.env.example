# Copie pra deploy/.env na VM (cp .env.example .env) e preencha.
# O .env NUNCA vai pro git (já está no .gitignore).
# Dica: os valores atuais estão no painel do Render → seu serviço → Environment.

# Domínio que aponta pro IP público da VM (ex.: myrank-api.duckdns.org).
API_DOMAIN=

# ── Banco (Neon) ─ copie igual está no Render ─────────────────────────────
# Formato: jdbc:postgresql://ep-xxxx-pooler.<regiao>.aws.neon.tech/neondb?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# 0 = o pool fecha as conexões ociosas e o Neon consegue suspender quando o site
# está parado (senão o Neon fica ligado 24h e come as horas grátis do plano).
DB_POOL_MIN_IDLE=0
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=60000

# ── App ──────────────────────────────────────────────────────────────────
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://myrank-oficial.vercel.app

# Cookie da sessão (HttpOnly). Os padrões já servem para produção quando front
# e API estão sob o mesmo domínio (SameSite=Strict, Secure=true, Domain vazio).
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=Strict
# AUTH_COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

TMDB_API_TOKEN=
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=
MAL_CLIENT_ID=

GEMINI_API_KEY=

# ── Email (Brevo) ─ códigos de cadastro, recuperação e exclusão ──────────
# Chave em brevo.com → SMTP & API → API Keys. O remetente precisa estar
# verificado em Senders & IP.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MyRank

# ── Bot de Discord ───────────────────────────────────────────────────────
# Segredo compartilhado do header X-Bot-Key (o mesmo valor no repo do bot).
# Gere com: openssl rand -hex 32
# Vazio/ausente = BotAuthenticationFilter desativado (a API só aceita JWT).
MYRANK_BOT_API_KEY=
